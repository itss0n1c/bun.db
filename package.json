{
	"name": "bun.db",
	"description": "A wrapper of quick.db for Bun.",
	"version": "1.1.3",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"scripts": {
		"build:lib": "tsdown",
		"build:docs": "typedoc --options typedoc.json",
		"build": "bun build:lib && bun build:docs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@types/bun": "1.2.20",
		"tsdown": "0.14.1",
		"typedoc-github-theme": "0.3.0",
		"typescript": "5.9.2"
	},
	"dependencies": {
		"quick.db": "9.1.7"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/warsam-e/bun.db.git"
	},
	"bugs": {
		"url": "https://github.com/warsam-e/bun.db/issues"
	},
	"homepage": "https://warsame.me/bun.db"
}
